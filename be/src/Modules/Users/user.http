@baseUrl = http://localhost:8080
@seedAdminEmail = admin.seed@example.com
@seedOwnerEmail = owner.seed@example.com
@seedCustomerEmail = customer.seed@example.com
@seedPassword = Password123!

### Login as the seeded admin
# @name loginAdmin
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedAdminEmail}}",
    "password": "{{seedPassword}}"
}

###

@adminToken = {{loginAdmin.response.body.$.accessToken}}

### Admin: Get all users (paginated)
GET {{baseUrl}}/api/users?page=1&pageSize=10
Accept: application/json
Authorization: Bearer {{adminToken}}

###

### Login as the seeded owner
# @name loginOwner
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedOwnerEmail}}",
    "password": "{{seedPassword}}"
}

###

### Login as the seeded customer
# @name loginCustomer
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedCustomerEmail}}",
    "password": "{{seedPassword}}"
}

###

@userId = {{loginOwner.response.body.$.userId}}
@accessToken = {{loginOwner.response.body.$.accessToken}}
@refreshToken = {{loginOwner.response.body.$.refreshToken}}

### Refresh the seeded owner's access token
# @name refreshOwner
POST {{baseUrl}}/api/users/refresh
Content-Type: application/json

{
    "refreshToken": "{{refreshToken}}"
}

###

@refreshedRefreshToken = {{refreshOwner.response.body.$.refreshToken}}

### Update the seeded owner's profile
PUT {{baseUrl}}/api/users/{{userId}}/profile
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "fullName": "Seed Vehicle Owner",
    "address": "1 Nguyen Hue, Ho Chi Minh City"
}

###

### Get the seeded owner's profile
GET {{baseUrl}}/api/users/{{userId}}/profile
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Get the seeded owner's booking eligibility
GET {{baseUrl}}/api/users/eligibility/{{userId}}
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Get the seeded owner's contact information
GET {{baseUrl}}/api/users/contact/{{userId}}
Accept: application/json
Authorization: Bearer {{accessToken}}

###

### Logout the seeded owner
POST {{baseUrl}}/api/users/logout
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "refreshToken": "{{refreshedRefreshToken}}"
}

###

@customerId = {{loginCustomer.response.body.$.userId}}
@customerToken = {{loginCustomer.response.body.$.accessToken}}

### Check customer verification status (initially false)
GET {{baseUrl}}/api/users/me/verification-status
Accept: application/json
Authorization: Bearer {{customerToken}}

###

### Verify customer's citizen ID (CCCD) (mock)
POST {{baseUrl}}/api/users/me/verify-id
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
    "documentNumber": "079095001234",
    "fullName": "Seed Customer",
    "address": "2 Le Loi, Ho Chi Minh City"
}

###

### Verify customer's driver's license (GPLX) (mock)
POST {{baseUrl}}/api/users/me/verify-driver-license
Content-Type: application/json
Authorization: Bearer {{customerToken}}

{
    "licenseNumber": "790123456789",
    "licenseClass": "B2"
}

###

### Access authenticated profile after both ID and driver's license are verified
GET {{baseUrl}}/api/users/{{customerId}}/profile
Accept: application/json
Authorization: Bearer {{customerToken}}
