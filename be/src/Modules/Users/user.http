@baseUrl = http://localhost:5218
@userId = 01a167ef-7614-7c92-9864-ada4bd0181a1
@adminId = 00000000-0000-0000-0000-000000000002
@ownerId = 00000000-0000-0000-0000-000000000003
@vehicleId = 00000000-0000-0000-0000-000000000004
@brandId = 00000000-0000-0000-0000-000000000005
@modelId = 00000000-0000-0000-0000-000000000006
@email = renter-{{$timestamp}}@example.com
@password = Password123!

### Register user
POST {{baseUrl}}/api/users/register
Content-Type: application/json

{
    "email": "{{email}}",
    "phone": "0901234567",
    "password": "{{password}}"
}

###

### Login user
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "0901234567",
    "password": "{{password}}"
}

###

### Update user profile
PUT {{baseUrl}}/api/users/{{userId}}/profile
Content-Type: application/json

{
    "fullName": "Nguyen Van A",
    "address": "123 Nguyen Hue, Ho Chi Minh City"
}

###

### Get full user profile
GET {{baseUrl}}/api/users/{{userId}}/profile
Accept: application/json

###

### Get user booking eligibility
GET {{baseUrl}}/api/users/eligibility/{{userId}}
Accept: application/json

###

### Get user contact information
GET {{baseUrl}}/api/users/contact/{{userId}}
Accept: application/json

###

### Ban user
PUT {{baseUrl}}/api/users/ban/{{userId}}/{{adminId}}
Accept: application/json

###

### Unban user
PUT {{baseUrl}}/api/users/unban/{{userId}}/{{adminId}}
Accept: application/json
