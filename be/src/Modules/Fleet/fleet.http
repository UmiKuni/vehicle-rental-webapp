@baseUrl = http://localhost:8080
@seedAdminEmail = admin.seed@example.com
@seedOwnerEmail = owner.seed@example.com
@seedPassword = Password123!
@brandId = 00000000-0000-0000-0000-000000000101
@modelId = 00000000-0000-0000-0000-000000000201

### Login as the seeded owner
# @name loginOwner
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedOwnerEmail}}",
    "password": "{{seedPassword}}"
}

###

@ownerId = {{loginOwner.response.body.$.userId}}
@accessToken = {{loginOwner.response.body.$.accessToken}}

### List the seeded owner's vehicles
# @name ownerVehicles
GET {{baseUrl}}/api/fleet/owners/{{ownerId}}/vehicles
Accept: application/json
Authorization: Bearer {{accessToken}}

###

@vehicleId = {{ownerVehicles.response.body.$[0].vehicleId}}

### List seeded brands
GET {{baseUrl}}/api/fleet/brands
Accept: application/json

###

### Get the seeded Toyota brand
GET {{baseUrl}}/api/fleet/brands/{{brandId}}
Accept: application/json

###

### List seeded models for Toyota
GET {{baseUrl}}/api/fleet/models?brandId={{brandId}}
Accept: application/json

###

### Get the seeded Toyota Vios model
GET {{baseUrl}}/api/fleet/models/{{modelId}}
Accept: application/json

###

### List published seeded vehicles
GET {{baseUrl}}/api/fleet/vehicles
Accept: application/json

###

### Get the first seeded vehicle
GET {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}
Accept: application/json

###

### Create a vehicle for the seeded owner
POST {{baseUrl}}/api/fleet/vehicles
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "ownerId": "{{ownerId}}",
    "plateNumber": "51K-999.23",
    "brandId": "{{brandId}}",
    "modelId": "{{modelId}}",
    "transmission": "Auto",
    "seats": 5,
    "latitude": 10.7769,
    "longitude": 106.7009,
    "address": "123 Nguyen Hue, Ben Nghe, District 1, Ho Chi Minh City"
}

###

### Update the first seeded vehicle
PUT {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "brandId": "{{brandId}}",
    "modelId": "{{modelId}}",
    "transmission": "Auto",
    "seats": 5,
    "latitude": 10.7769,
    "longitude": 106.7009,
    "address": "1 Nguyen Hue, District 1, Ho Chi Minh City"
}

###

### Submit the first seeded vehicle for approval
POST {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}/submit
Authorization: Bearer {{accessToken}}

###

### Hide the first seeded vehicle
POST {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}/hide
Authorization: Bearer {{accessToken}}

###

### Show the first seeded vehicle
POST {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}/show
Authorization: Bearer {{accessToken}}

###

### Upload an image to the first seeded vehicle
# @name uploadVehicleImage
POST {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}/images
Authorization: Bearer {{accessToken}}
Content-Type: multipart/form-data; boundary=----FleetImageBoundary

------FleetImageBoundary
Content-Disposition: form-data; name="file"; filename="hero.png"
Content-Type: image/png

< ../../../../fe/src/assets/hero.png
------FleetImageBoundary--

###

@vehicleImageId = {{uploadVehicleImage.response.body.$.imageId}}

### Delete the uploaded vehicle image
DELETE {{baseUrl}}/api/fleet/vehicles/{{vehicleId}}/images/{{vehicleImageId}}
Authorization: Bearer {{accessToken}}

###

### ============================================================
### Complete owner flow: login -> create -> submit -> get details
### ============================================================

@flowPlateNumber = 51K-FLO4-{{$randomInt}}

### 1. Login as the seeded owner
# @name fleetFlowLogin
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedOwnerEmail}}",
    "password": "{{seedPassword}}"
}

###

@fleetFlowOwnerId = {{fleetFlowLogin.response.body.$.userId}}
@fleetFlowAccessToken = {{fleetFlowLogin.response.body.$.accessToken}}

### 2. Create a new fleet vehicle
# @name fleetFlowCreate
POST {{baseUrl}}/api/fleet/vehicles
Content-Type: application/json
Authorization: Bearer {{fleetFlowAccessToken}}

{
    "ownerId": "{{fleetFlowOwnerId}}",
    "plateNumber": "{{flowPlateNumber}}",
    "brandId": "{{brandId}}",
    "modelId": "{{modelId}}",
    "transmission": "Auto",
    "seats": 5,
    "latitude": 10.7769,
    "longitude": 106.7009,
    "address": "25 Nguyen Hue, Ben Nghe, District 1, Ho Chi Minh City"
}

###

@fleetFlowVehicleId = {{fleetFlowCreate.response.body.$.vehicleId}}

### 3. Upload an image as the vehicle's primary image
# @name fleetFlowUploadImage
POST {{baseUrl}}/api/fleet/vehicles/{{fleetFlowVehicleId}}/images
Authorization: Bearer {{fleetFlowAccessToken}}
Content-Type: multipart/form-data; boundary=----FleetFlowImageBoundary

------FleetFlowImageBoundary
Content-Disposition: form-data; name="file"; filename="fleet-flow.png"
Content-Type: image/png

< ../../../../fe/src/assets/hero.png
------FleetFlowImageBoundary--

###

### 4. Upload a second image
POST {{baseUrl}}/api/fleet/vehicles/{{fleetFlowVehicleId}}/images
Authorization: Bearer {{fleetFlowAccessToken}}
Content-Type: multipart/form-data; boundary=----FleetFlowImageBoundary

------FleetFlowImageBoundary
Content-Disposition: form-data; name="file"; filename="fleet-flow-2.png"
Content-Type: image/png

< ../../../../fe/src/assets/hero.png
------FleetFlowImageBoundary--

###

### 5. Upload a third image
POST {{baseUrl}}/api/fleet/vehicles/{{fleetFlowVehicleId}}/images
Authorization: Bearer {{fleetFlowAccessToken}}
Content-Type: multipart/form-data; boundary=----FleetFlowImageBoundary

------FleetFlowImageBoundary
Content-Disposition: form-data; name="file"; filename="fleet-flow-3.png"
Content-Type: image/png

< ../../../../fe/src/assets/hero.png
------FleetFlowImageBoundary--

###

### 6. Submit the newly created vehicle for approval
POST {{baseUrl}}/api/fleet/vehicles/{{fleetFlowVehicleId}}/submit
Authorization: Bearer {{fleetFlowAccessToken}}

###

### 7. Get the submitted vehicle details
GET {{baseUrl}}/api/fleet/vehicles/{{fleetFlowVehicleId}}
Accept: application/json
Authorization: Bearer {{fleetFlowAccessToken}}

###

### ============================================================
### Admin flow: login -> create brand -> create models
### ============================================================

@createBrandName = Test Brand 1
@createModelName1 = Test Model A {{$randomInt}}
@createModelName2 = Test Model B {{$randomInt}}

### 1. Login as the seeded admin
# @name fleetAdminLogin
POST {{baseUrl}}/api/users/login
Content-Type: application/json

{
    "identifier": "{{seedAdminEmail}}",
    "password": "{{seedPassword}}"
}

###

@fleetAdminToken = {{fleetAdminLogin.response.body.$.accessToken}}

### 2. Create a brand
# @name fleetCreateBrand
POST {{baseUrl}}/api/fleet/brands
Content-Type: application/json
Authorization: Bearer {{fleetAdminToken}}

{
    "name": "{{createBrandName}}"
}

###

@fleetCreatedBrandId = {{fleetCreateBrand.response.body.$.brandId}}

### 3. Create the first model for the new brand
# @name fleetCreateModel1
POST {{baseUrl}}/api/fleet/models
Content-Type: application/json
Authorization: Bearer {{fleetAdminToken}}

{
    "brandId": "{{fleetCreatedBrandId}}",
    "name": "{{createModelName1}}"
}

###

@fleetCreatedModelId1 = {{fleetCreateModel1.response.body.$.modelId}}

### 4. Create the second model for the new brand
# @name fleetCreateModel2
POST {{baseUrl}}/api/fleet/models
Content-Type: application/json
Authorization: Bearer {{fleetAdminToken}}

{
    "brandId": "{{fleetCreatedBrandId}}",
    "name": "{{createModelName2}}"
}

###

@fleetCreatedModelId2 = {{fleetCreateModel2.response.body.$.modelId}}

### 5. List models for the newly created brand
GET {{baseUrl}}/api/fleet/models?brandId={{fleetCreatedBrandId}}
Accept: application/json

### 6. Get the newly created brand
GET {{baseUrl}}/api/fleet/brands/{{fleetCreatedBrandId}}
Accept: application/json

### 7. Get the first newly created model
GET {{baseUrl}}/api/fleet/models/{{fleetCreatedModelId1}}
Accept: application/json

### 8. Get the second newly created model
GET {{baseUrl}}/api/fleet/models/{{fleetCreatedModelId2}}
Accept: application/json
