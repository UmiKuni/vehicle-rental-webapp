# ==============================================================================
# Car Rental Platform: Environment Variables Template
# Copy this file to '.env' and update the secrets for local development or deployment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_DB=carrental
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Redis Cache & Lock Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# ASP.NET Core Application Configuration
# ------------------------------------------------------------------------------
APP_PORT=8080
ASPNETCORE_ENVIRONMENT=Development

# ------------------------------------------------------------------------------
# Payment Gateways Configuration & Secrets
# ------------------------------------------------------------------------------
PAYMENTS_USE_MOCK_GATEWAY=false

# VNPay
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_BASE_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_API_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CURRENCY=USD
PAYPAL_EXCHANGE_RATE=25000

# Stripe (Publishable key is optional for back-end, can be left empty in file)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_CURRENCY=vnd

# Bank Transfer / VietQR
TRANSFER_BANK_CODE=
TRANSFER_ACCOUNT_NUMBER=
TRANSFER_ACCOUNT_NAME=
TRANSFER_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Notifications: SMTP Email and Twilio SMS
# ------------------------------------------------------------------------------
NOTIFICATIONS_SMTP_HOST=
NOTIFICATIONS_SMTP_PORT=587
NOTIFICATIONS_SMTP_ENABLESSL=true
NOTIFICATIONS_SMTP_USERNAME=
NOTIFICATIONS_SMTP_PASSWORD=
NOTIFICATIONS_SMTP_FROMADDRESS=
NOTIFICATIONS_SMTP_FROMNAME=CarRental
NOTIFICATIONS_TWILIO_ACCOUNTSID=
NOTIFICATIONS_TWILIO_AUTHTOKEN=
NOTIFICATIONS_TWILIO_FROMNUMBER=
NOTIFICATIONS_TWILIO_MESSAGINGSERVICESID=
NOTIFICATIONS_TWILIO_BASEURL=https://api.twilio.com
NOTIFICATIONS_TWILIO_DEFAULTCOUNTRYCODE=+84

# ------------------------------------------------------------------------------
# Cloudinary Media Storage (Optional in Development; uses in-memory if empty)
# ------------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

